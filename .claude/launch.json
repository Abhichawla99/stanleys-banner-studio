{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "/Users/home/.local/node/bin/node",
      "runtimeArgs": ["--env-file=.env", "server/index.mjs"],
      "port": 3001
    },
    {
      "name": "client",
      "runtimeExecutable": "/Users/home/.local/node/bin/npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true,
      "cwd": "client"
    },
    {
      "name": "aiflow-server",
      "runtimeExecutable": "/Users/home/.local/node/bin/node",
      "runtimeArgs": ["server.js"],
      "port": 3001,
      "cwd": "aiflow"
    },
    {
      "name": "aiflow-client",
      "runtimeExecutable": "/Users/home/.local/node/bin/npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "autoPort": true,
      "cwd": "aiflow"
    }
  ]
}
